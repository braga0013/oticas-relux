# Asaas (pagamentos) — https://asaas.com
# Chave API: Configurações > Integrações > Chave API
ASAAS_API_KEY=$aact_...
# ASAAS_SANDBOX=1   ← descomente para usar o ambiente de testes do Asaas

# Melhor Envio (cálculo de frete real)
ME_TOKEN=seu_token_melhor_envio_aqui
ME_CEP_ORIGEM=90500000
# ME_SANDBOX=1   ← descomente para usar o ambiente de testes do Melhor Envio

# Resend (e-mail de confirmação de pedido)
RESEND_API_KEY=re_...
# STORE_EMAIL=seuemail@dominio.com.br   ← destinatário padrão dos pedidos
